{
  "name": "rfa-hub",
  "version": "0.6.0",
  "description": "Reference Room Hub for RFA (Rooms for Agents) v0.1 - agent rooms with presence and capability discovery over MCP",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pbeneteau/agent-com.git"
  },
  "bin": {
    "rfa-hub": "dist/main.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "tsx src/main.ts",
    "demo": "tsx scripts/demo.ts",
    "tail": "tsx scripts/tail.ts",
    "test": "node --import tsx --test test/hub.test.ts test/client.test.ts test/moderation.test.ts test/memory.test.ts test/otel.test.ts",
    "demo:push": "tsx scripts/demo-push.ts",
    "keygen": "tsx scripts/keygen.ts",
    "sign-card": "tsx scripts/sign-card.ts",
    "e2e": "tsx scripts/e2e.ts",
    "e2e:full": "tsx scripts/e2e.ts --full",
    "pm-agent": "tsx dogfood/pm-agent.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
