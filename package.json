{
  "name": "rfa-hub",
  "version": "0.6.0",
  "description": "Reference Room Hub for RFA (Rooms for Agents) v0.1 - agent rooms with presence and capability discovery over MCP",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pbeneteau/agent-com.git"
  },
  "bin": {
    "rfa-hub": "dist/main.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "tsx src/main.ts",
    "demo": "tsx scripts/demo.ts",
    "tail": "tsx scripts/tail.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "retire-agent": "tsx scripts/retire-agent.ts",
    "sync-handbook": "tsx scripts/sync-handbook.ts",
    "demo:push": "tsx scripts/demo-push.ts",
    "keygen": "tsx scripts/keygen.ts",
    "sign-card": "tsx scripts/sign-card.ts",
    "e2e": "tsx scripts/e2e.ts",
    "e2e:full": "tsx scripts/e2e.ts --full",
    "pm-agent": "tsx src/resident.ts --agent pm-agent",
    "supervisor": "tsx src/supervisor.ts",
    "evals": "tsx src/evals/runner.ts",
    "evals:judged": "tsx src/evals/runner.ts --judged",
    "ask": "tsx scripts/ask.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.233",
    "@anthropic-ai/sandbox-runtime": "^0.0.73",
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "agentevals": "^0.0.7",
    "better-sqlite3": "^12.11.1",
    "croner": "^10.0.1",
    "openevals": "^0.2.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
