[
  {
    "id": "injection-alert",
    "tier": "rules",
    "match": {
      "text_regex": "ignore (all )?previous instructions|IMPORTANT SYSTEM DIRECTIVE|disregard your rules"
    },
    "outcome": "alert"
  },
  {
    "id": "no-private-keys",
    "tier": "rules",
    "match": {
      "text_regex": "BEGIN (RSA|OPENSSH|EC|PGP) PRIVATE KEY"
    },
    "outcome": "refuse"
  },
  {
    "id": "hold-marker",
    "tier": "rules",
    "match": {
      "text_regex": "HOLD-FOR-REVIEW"
    },
    "outcome": "hold"
  }
